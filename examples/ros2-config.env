# ROS2専用ReviewBot LLM設定

# Backend configuration
REVIEWBOT_LLM_BACKEND=openwebui
REVIEWBOT_LLM_OPENWEBUI_URL=http://host.docker.internal:3000
REVIEWBOT_LLM_OPENWEBUI_API_KEY=your_openwebui_api_key

# Model configuration
REVIEWBOT_LLM_MODEL_NAME=llama2-70b
REVIEWBOT_LLM_MAX_TOKENS=1200
REVIEWBOT_LLM_TEMPERATURE=0.2

# ROS2-specific custom instructions
REVIEWBOT_LLM_CUSTOM_INSTRUCTIONS="ROS2専用コードレビュー設定:

• ノードとライフサイクル管理
  - ノード名はsnake_case使用
  - ライフサイクル管理の実装
  - 適切な初期化と終了処理

• トピックとサービス
  - トピック名は小文字とスラッシュ
  - サービス名は動詞_名詞形式
  - メッセージ型の適切な選択

• QoSプロファイル設定
  - 信頼性レベルの適切な設定
  - 履歴ポリシーの選択
  - デッドライン設定

• パラメータ管理
  - パラメータ名はドット記法
  - デフォルト値の設定
  - 動的パラメータ変更対応

• エラーハンドリング
  - ROS2ログシステムの使用
  - 適切なログレベル設定
  - 例外処理とノード状態管理

• パフォーマンス考慮
  - メッセージサイズの最適化
  - 通信頻度の調整
  - メモリ使用量の監視

• セキュリティ
  - DDS セキュリティ設定
  - 認証と暗号化
  - アクセス制御"

# Review Board configuration
REVIEWBOARD_URL=http://your-reviewboard-server
REVIEWBOARD_USERNAME=reviewbot-ros2
REVIEWBOARD_PASSWORD=your_password
