# Python専用ReviewBot LLM設定

# Backend configuration
REVIEWBOT_LLM_BACKEND=openwebui
REVIEWBOT_LLM_OPENWEBUI_URL=http://host.docker.internal:3000
REVIEWBOT_LLM_OPENWEBUI_API_KEY=your_openwebui_api_key

# Model configuration
REVIEWBOT_LLM_MODEL_NAME=gpt-4
REVIEWBOT_LLM_MAX_TOKENS=1500
REVIEWBOT_LLM_TEMPERATURE=0.1

# Python-specific custom instructions
REVIEWBOT_LLM_CUSTOM_INSTRUCTIONS="Python専用コードレビュー設定:

• PEP 8準拠チェック
  - インデント、命名規則、行長制限
  - インポート順序とスタイル

• 型ヒントとドキュメント
  - 関数の型ヒント必須
  - docstring記述必須
  - 複雑なロジックのコメント

• セキュリティチェック
  - SQLインジェクション対策
  - 入力値検証
  - 機密情報のハードコード禁止

• パフォーマンス最適化
  - リスト内包表記の活用
  - 不要なループの回避
  - メモリ効率の考慮

• エラーハンドリング
  - 具体的な例外タイプ指定
  - ログ出力の適切な使用
  - 例外の適切な伝播"

# Review Board configuration
REVIEWBOARD_URL=http://your-reviewboard-server
REVIEWBOARD_USERNAME=reviewbot-python
REVIEWBOARD_PASSWORD=your_password
