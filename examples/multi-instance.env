# Environment variables for multi-instance deployment
# Copy this file to .env and customize the values

# Review Board configuration (shared by all instances)
REVIEWBOARD_URL=http://your-reviewboard-server
REVIEWBOARD_PASSWORD=your_reviewbot_password

# API Keys for LLM backends
OPENWEBUI_API_KEY=your_openwebui_api_key_here
LLAMACPP_API_KEY=your_llamacpp_api_key_here

# Optional: Custom model configurations
# Uncomment and modify as needed

# Python instance specific
# PYTHON_MODEL_NAME=gpt-4
# PYTHON_MAX_TOKENS=1500

# C++ instance specific  
# CPP_MODEL_NAME=codellama-13b
# CPP_MAX_TOKENS=2000

# ROS2 instance specific
# ROS2_MODEL_NAME=llama2-70b
# ROS2_MAX_TOKENS=1200

# General instance specific
# GENERAL_MODEL_NAME=mixtral-8x7b
# GENERAL_MAX_TOKENS=1000
